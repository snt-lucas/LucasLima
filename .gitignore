# ==============================================================================
# .gitignore — Portfólio Web (HTML, CSS, JavaScript & Assets)
# ==============================================================================

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Backups e arquivos temporários
*.bak
*.old
*.orig
*.tmp
*.temp
*#*

# Logs e relatórios
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependências (caso sejam integradas futuramente)
node_modules/
dist/
build/
.cache/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
